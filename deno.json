{
  "name": "@algosail/plystream",
  "version": "0.2.0",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./disposable": "./disposable.ts",
    "./scheduler": "./scheduler.ts",
    "./stream": "./stream.ts",
    "./behavior": "./behavior.ts",
    "./future": "./future.ts",
    "./transaction": "./transaction.ts"
  },
  "publish": {
    "exclude": ["**/*_test.ts", ".zed", ".github"]
  },
  "tasks": {
    "test": "deno test --doc",
    "check": "deno fmt --check && deno lint && deno check *.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@algosail/ply": "jsr:@algosail/ply@0.1.0",
    "@algosail/plyfuture": "jsr:@algosail/plyfuture@0.1.0",
    "@algosail/plystream": "./mod.ts",
    "@algosail/plystream/future": "./future.ts"
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "exclude": [".zed"]
  },
  "lint": {
    "exclude": [".zed"]
  }
}
